# Local Vite requests use the /api proxy in vite.config.ts by default.
# Set this only when testing against a separately hosted backend.
# VITE_API_BASE_URL=https://example.com/api

# OAuth public client identifiers used by the browser login flow.
VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_CLIENT_ID=

# Local API test data only. Use a child_id that belongs to the account in your
# fresh access token. Never put an access token in an env file.
VITE_TIME_CAPSULE_CHILD_ID=1

# Firebase console > Project settings > General > Your apps > Web app
# These web identifiers are public client configuration, not service-account secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase console > Project settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=
