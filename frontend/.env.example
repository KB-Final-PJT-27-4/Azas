# Local Vite requests use the /api proxy in vite.config.ts by default.
# Set this only when testing against a separately hosted backend.
# VITE_API_BASE_URL=https://example.com/api

# OAuth 앱 콘솔에 아래 Redirect URI도 각각 등록해야 합니다.
# http://localhost:5173/auth/google/callback
# http://localhost:5173/auth/kakao/callback
VITE_GOOGLE_CLIENT_ID=46492149889-i45bh18k936stq7h64c183r51purkd28.apps.googleusercontent.com
VITE_KAKAO_CLIENT_ID=7e4b8166eb19a16bfbb799bfb48cb888
# Local API test data only. Use a child_id that belongs to the account in your
# fresh access token. Never put an access token in an env file.
VITE_TIME_CAPSULE_CHILD_ID=1
