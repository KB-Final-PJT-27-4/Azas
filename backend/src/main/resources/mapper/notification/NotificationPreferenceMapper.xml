<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace=
                "com.azas.domain.notification.mapper.NotificationPreferenceMapper">

    <resultMap id="notificationPreferenceRowMap"
               type=
                       "com.azas.domain.notification.dto.NotificationPreferenceRow">

        <result property="notificationCategory"
                column="notification_category"/>

        <result property="enabled"
                column="enabled"/>
    </resultMap>

    <select id="findNotificationPreferences"
            resultMap="notificationPreferenceRowMap">

        SELECT
            notification_category,
            enabled
        FROM notification_preference
        WHERE member_id = #{memberId}

    </select>

    <insert id="upsertNotificationPreferences">
        INSERT INTO notification_preference (
        member_id,
        notification_category,
        enabled
        )
        VALUES
        <foreach collection="items"
                 item="item"
                 separator=",">
            (
            #{memberId},
            #{item.notificationCategory},
            #{item.enabled}
            )
        </foreach>
        ON DUPLICATE KEY UPDATE
        enabled = VALUES(enabled),
        updated_at = CURRENT_TIMESTAMP(6)
    </insert>
</mapper>