<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.azas.domain.auth.mapper.FamilyInvitationMapper">

    <resultMap
            id="familyInvitationResultMap"
            type="com.azas.domain.auth.entity.FamilyInvitation">

        <id
                property="familyInvitationId"
                column="family_invitation_id"/>

        <result
                property="childId"
                column="child_id"/>

        <result
                property="inviterMemberId"
                column="inviter_member_id"/>

        <result
                property="inviteeType"
                column="invitee_type"/>

        <result
                property="relationType"
                column="relation_type"/>

        <result
                property="inviteTokenHash"
                column="invite_token_hash"/>

        <result
                property="status"
                column="status"/>

        <result
                property="expiresAt"
                column="expires_at"/>

        <result
                property="acceptedMemberId"
                column="accepted_member_id"/>

        <result
                property="acceptedAt"
                column="accepted_at"/>

        <result
                property="createdAt"
                column="created_at"/>

        <result
                property="updatedAt"
                column="updated_at"/>

    </resultMap>

    <sql id="familyInvitationColumns">
        family_invitation_id,
        child_id,
        inviter_member_id,
        invitee_type,
        relation_type,
        invite_token_hash,
        status,
        expires_at,
        accepted_member_id,
        accepted_at,
        created_at,
        updated_at
    </sql>

    <select
            id="findByInviteTokenHash"
            resultMap="familyInvitationResultMap">

        SELECT
        <include refid="familyInvitationColumns"/>
        FROM family_invitation
        WHERE invite_token_hash = #{inviteTokenHash}

    </select>

    <update id="acceptIfPending">

        UPDATE family_invitation
        SET
            status = 'ACCEPTED',
            relation_type = #{relationType, jdbcType=VARCHAR},
            accepted_member_id = #{acceptedMemberId},
            accepted_at = #{acceptedAt},
            updated_at = CURRENT_TIMESTAMP(6)
        WHERE family_invitation_id = #{familyInvitationId}
          AND status = 'PENDING'
          AND accepted_member_id IS NULL
          AND expires_at > #{acceptedAt}

    </update>

</mapper>