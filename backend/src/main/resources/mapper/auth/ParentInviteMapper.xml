<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.azas.domain.auth.mapper.ParentInviteMapper">

    <resultMap
            id="childResultMap"
            type="com.azas.domain.child.entity.Child">

        <id property="childId" column="child_id"/>
        <result property="memberId" column="member_id"/>
        <result property="name" column="name"/>
        <result property="birthStatus" column="birth_status"/>
        <result property="expectedBirthDate" column="expected_birth_date"/>
        <result property="birthDate" column="birth_date"/>
        <result property="gender" column="gender"/>
        <result property="profileImageUrl" column="profile_image_url"/>
        <result property="childStatus" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="childColumns">
        child_id,
        member_id,
        name,
        birth_status,
        expected_birth_date,
        birth_date,
        gender,
        profile_image_url,
        status,
        created_at,
        updated_at
    </sql>

    <select
            id="findActiveChildById"
            resultMap="childResultMap">

        SELECT
        <include refid="childColumns"/>
        FROM child
        WHERE child_id = #{childId}
        AND status = 'ACTIVE'

    </select>

    <select
            id="countChildParentRelation"
            resultType="int">

        SELECT COUNT(*)
        FROM child_parent
        WHERE child_id = #{childId}
          AND member_id = #{memberId}

    </select>

    <insert id="insertChildParentRelation">

        INSERT INTO child_parent (
            child_id,
            member_id,
            relation_type,
            created_at,
            updated_at
        ) VALUES (
                     #{childId},
                     #{memberId},
                     #{relationType},
                     CURRENT_TIMESTAMP(6),
                     CURRENT_TIMESTAMP(6)
                 )

    </insert>

</mapper>
