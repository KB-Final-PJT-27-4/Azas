<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.azas.domain.auth.mapper.ChildInviteMapper">

    <resultMap
            id="childResultMap"
            type="com.azas.domain.child.entity.Child">

        <id property="childId" column="child_id"/>
        <result property="memberId" column="member_id"/>
        <result property="name" column="name"/>
        <result property="birthStatus" column="birth_status"/>
        <result property="expectedBirthDate" column="expected_birth_date"/>
        <result property="birthDate" column="birth_date"/>
        <result property="gender" column="gender"/>
        <result property="profileImageUrl" column="profile_image_url"/>
        <result property="childStatus" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result
                property="lastAllowanceRequestMonth"
                column="last_allowance_request_month"/>
        <result
                property="lastAllowanceRequestAt"
                column="last_allowance_requested_at"/>

    </resultMap>

    <sql id="childColumns">
        child_id,
        member_id,
        name,
        birth_status,
        expected_birth_date,
        birth_date,
        gender,
        profile_image_url,
        status,
        created_at,
        updated_at,
        last_allowance_request_month,
        last_allowance_requested_at
    </sql>

    <select
            id="findActiveById"
            resultMap="childResultMap">

        SELECT
        <include refid="childColumns"/>
        FROM child
        WHERE child_id = #{childId}
        AND status = 'ACTIVE'

    </select>

    <select
            id="findByMemberId"
            resultMap="childResultMap">

        SELECT
        <include refid="childColumns"/>
        FROM child
        WHERE member_id = #{memberId}

    </select>

    <update id="linkMemberIfUnlinked">

        UPDATE child
        SET
            member_id = #{memberId},
            updated_at = CURRENT_TIMESTAMP(6)
        WHERE child_id = #{childId}
          AND member_id IS NULL
          AND status = 'ACTIVE'

    </update>

</mapper>